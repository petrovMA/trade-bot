# Dockerfile for pre-built frontend with SSL support
# Use this when you have SSL certificates on the server

FROM nginx:1.25-alpine

# Copy pre-built frontend into /trade-bot/ subdirectory
# so that nginx "root" directive resolves /trade-bot/assets/* correctly
COPY dist /usr/share/nginx/html/trade-bot

# Copy SSL-enabled nginx configuration
COPY nginx/nginx-ssl.conf /etc/nginx/conf.d/default.conf

# Expose both HTTP and HTTPS ports
EXPOSE 80 443

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  # BusyBox wget may resolve localhost to ::1 first and not fallback to 127.0.0.1, while nginx may not listen on IPv6.
  CMD wget --no-check-certificate --quiet --tries=1 --spider https://127.0.0.1/health || exit 1

CMD ["nginx", "-g", "daemon off;"]